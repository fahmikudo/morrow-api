DATABASE_URL=postgres://secondbrain:secondbrain@127.0.0.1:5433/secondbrain
BIND_ADDR=127.0.0.1:8080
CORS_ORIGIN=http://localhost:5173
TOKEN_TTL_DAYS=30
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
APP_TIMEZONE=UTC
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=admin@example.com
REMINDER_TICK_SECONDS=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/api/v1/integrations/google-calendar/oauth/callback
APP_ENCRYPTION_KEY=
CALENDAR_SYNC_SECONDS=300
PEPY_ENABLED=false
PEPY_ALLOWED_EMAILS=
PEPY_BASE_URL=https://softwareseniapi.pepy.app/api/v1
PEPY_USERNAME=
PEPY_PASSWORD=
PEPY_USER_ID=820
PEPY_PROJECT_ID=5674
PEPY_LOGIN_INTERVAL_SECONDS=259200
PEPY_SYNC_SECONDS=300
# Cloudflare R2 — development and production both use the real bucket.
# Dashboard → R2 → Manage API tokens → Create token (Object Read & Write,
# scoped to this bucket). The account ID is on the R2 overview page; access key
# ID is 32 chars, secret is 64. Empty credentials disable attachments.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Browser-facing host used only when signing URLs; empty reuses S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# R2 always reports "auto".
S3_REGION=auto
S3_BUCKET=<BUCKET_NAME>
S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
# R2 requires virtual-hosted style; never enable path style.
S3_FORCE_PATH_STYLE=false
# Leave false: the bucket is created in the dashboard, never by the API.
S3_AUTO_CREATE_BUCKET=false
ATTACHMENT_URL_TTL_SECONDS=900
LOG_LEVEL=info
LOG_FILE=
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE_DAYS=14
LOG_COMPRESS=false
