# =============================================================================
# morrow-api — production environment
#
# On the server this file is /opt/morrow-api/.env (chmod 600, never in git).
#   scp deploy/.env.example deploy@<server>:/opt/morrow-api/.env
# =============================================================================

# Release — deploy.sh rewrites this on every release. To roll back, put the
# previous tag here (1.2.0 or sha-xxxxxxx from GHCR) and run `docker compose up -d`.
MORROW_API_IMAGE_TAG=

# Loopback port the host nginx proxies to. Must match the upstream in
# /etc/nginx/sites-available/<api-site>.conf.
APP_PORT=8990

TZ=UTC
APP_TIMEZONE=Asia/Jakarta
TOKEN_TTL_DAYS=30

# --- Database ---------------------------------------------------------------
# Postgres runs as the `db` service in this stack, backed by the `pgdata`
# volume. Generate the password once: openssl rand -hex 24 (URL-safe, no
# characters that need percent-encoding). Changing POSTGRES_PASSWORD later does
# not change the role inside an existing volume.
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=<RANDOM_48_HEX>
POSTGRES_DB=secondbrain
# Host `db` is the compose service. sslmode=disable is safe on the compose
# network; for a managed database use its URL with sslmode=require and delete
# the `db` service plus the api's depends_on in docker-compose.yml.
DATABASE_URL=postgres://secondbrain:<RANDOM_48_HEX>@db:5432/secondbrain?sslmode=disable

# The public frontend origin; browsers send credentials from here.
CORS_ORIGIN=https://mrrw.my.id

# --- Cloudflare R2 (attachments) -------------------------------------------
# Dashboard → R2 → API → Manage API tokens. Scope the token to this bucket with
# Object Read & Write. The account ID is on the R2 overview page.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<BUCKET_NAME>
S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
S3_FORCE_PATH_STYLE=false
S3_AUTO_CREATE_BUCKET=false
ATTACHMENT_URL_TTL_SECONDS=900

# --- Web push ---------------------------------------------------------------
# Generate a pair with `make vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=admin@example.com
REMINDER_TICK_SECONDS=60

# --- Encryption -------------------------------------------------------------
# base64, decodes to 32 bytes; encrypts stored integration tokens.
APP_ENCRYPTION_KEY=

# --- Google Calendar (optional) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.mrrw.my.id/api/v1/integrations/google-calendar/oauth/callback
CALENDAR_SYNC_SECONDS=300

# --- Pepy sync (optional) ---------------------------------------------------
PEPY_ENABLED=false
PEPY_ALLOWED_EMAILS=
PEPY_BASE_URL=https://softwareseniapi.pepy.app/api/v1
PEPY_USERNAME=
PEPY_PASSWORD=
PEPY_USER_ID=
PEPY_PROJECT_ID=
PEPY_LOGIN_INTERVAL_SECONDS=259200
PEPY_SYNC_SECONDS=300

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE_DAYS=14
LOG_COMPRESS=false
